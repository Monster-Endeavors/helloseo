---
import Form from '../components/blocks/Form.astro';
import Img from '../components/blocks/Img.astro';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Text from '../components/blocks/Text.astro';
import { contactForm } from '../data/forms';
import blueIvoryPurpleCorners from '../assets/images/blue-ivory-purple-corners.png';
import gradient36abaf04 from '../assets/images/gradient-36abaf04.png';
import socialShare6a8726b0 from '../assets/images/social-share-6a8726b0.png';
---

<Layout title="Contact | HelloSEO" description="Contact HelloSEO for expert SEO services, content strategies, and digital marketing solutions. Reach out to boost your brand's visibility and credibility today." ogImage={socialShare6a8726b0} headerTheme="white">
  <Section theme="white" inset grid={{ rows: [18, 15], rowGap: 11, colGap: 11 }}>
    <Img m="2/2/17/10" d="2/2/15/26" z={1} align="center" outline={{ border: '4px solid #d34320', radius: '34px' }} src={blueIvoryPurpleCorners} alt="Blurred gradient background with soft pastel colors blending from light blue to pink." radius="30px" parallax={{ intensity: 20, rotation: 45, zoomStart: 2 }} sizes="(max-width: 767px) 100vw, 100vw" eager />
    <Text m="3/3/15/9" d="5/8/12/20" z={2} align="center">
      <h2 class="ta-center"><span class="c-black">Say</span><span class="c-lightAccent"> hello</span> to clarity, ideal clients, and brand credibility.</h2>
      <p class="large ta-center">Whether you’re looking for an SEO partner, a results-driven content strategy, or something in between, we’d love to hear from you.&nbsp;</p>
    </Text>
    <Img m="15/4/18/8" d="13/12/16/16" z={3} align="center" anim={{ animations: [{ trigger: 'loop', duration: 2, ease: 'ease-in-out', frames: [{ y: '20%', sx: 0.95, sy: 0.95 }] }] }} src={gradient36abaf04} alt="A simple, stylized white cat with a smiling face on a red background." fit="contain" sizes="(max-width: 767px) 50vw, 17vw" eager />
  </Section>

  <Section height="small" grid={{ rows: [18, 35], rowGap: 11, colGap: 11 }}>
    <Form m="1/2/17/10" d="1/7/35/20" z={1} form={contactForm} radius="20px" />
  </Section>
</Layout>
