---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog | HelloSEO" headerTheme="white-bold">
  <section class="section blog-section" data-theme="white-bold">
    <div class="section__border"></div>
    <div class="section__content">
      <div class="blog-list">
        {
          posts.map((post) => (
            <article class="blog-card">
              <a href={`/blog/${post.id}`} class="blog-card__image" data-reveal="image">
                <Image src={post.data.image} alt={post.data.imageAlt} widths={[500, 750, 1000]} sizes="(max-width: 767px) 100vw, 33vw" />
              </a>
              <div class="blog-card__summary">
                <h1 class="blog-card__title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h1>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
