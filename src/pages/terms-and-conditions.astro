---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Text from '../components/blocks/Text.astro';
import socialShare6a8726b0 from '../assets/images/social-share-6a8726b0.png';
---

<Layout title="Terms and Conditions | Understand Policies & Take Action | HelloSEO" description="Review HelloSEO's terms and conditions to understand our policies on SEO services, digital marketing, and user conduct for optimal service experience." ogImage={socialShare6a8726b0} headerTheme="bright">
  <Section theme="bright" divider={{ height: '6vw', stroke: 'var(--lightAccent)', strokeWidth: '8px' }} grid={{ rows: [5, 5], rowGap: 11, colGap: 11 }}>
    <Text m="3/2/5/10" d="3/9/6/19" z={1} align="center" alignM="start">
      <h1 class="ta-center"><span class="c-darkAccent">Terms and Conditions</span></h1>
    </Text>
  </Section>

  <Section theme="white" grid={{ rows: [19, 12], rowGap: 11, colGap: 11 }} prevDivider="6vw">
    <Text m="2/2/19/10" d="3/3/5/25" z={2}>

    </Text>
  </Section>
</Layout>
