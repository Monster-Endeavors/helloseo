---
import Button from '../components/blocks/Button.astro';
import Img from '../components/blocks/Img.astro';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Shape from '../components/blocks/Shape.astro';
import Text from '../components/blocks/Text.astro';
import blueIvoryPurpleBlend from '../assets/images/blue-ivory-purple-blend.png';
import blueIvoryPurpleCorners from '../assets/images/blue-ivory-purple-corners.png';
import gradient36abaf04 from '../assets/images/gradient-36abaf04.png';
import image2 from '../assets/images/image2.png';
import image4 from '../assets/images/image4.png';
import image6 from '../assets/images/image6.png';
import kaboompicsCloseUpOfWomanTypingOnLaptopOn from '../assets/images/kaboompics-close-up-of-woman-typing-on-laptop-on-sofa-43378.jpg';
import kaboompicsYoungAsianWomanAtOffice21922 from '../assets/images/kaboompics-young-asian-woman-at-office-21922.jpg';
import socialShare6a8726b0 from '../assets/images/social-share-6a8726b0.png';
---

<Layout title="Case Study 1 | Boost Visibility Today — Discover Results | HelloSEO" description="Explore our SEO case study demonstrating significant increases in search visibility, reduced ad spend, and qualified leads for a Chicago therapy practice." ogImage={socialShare6a8726b0}>
  <Section height="medium" bg={{ src: blueIvoryPurpleBlend, overlay: 0.15, eager: true }} grid={{ rows: [45, 40], rowGap: 11, colGap: 34 }}>
    <Text m="1/2/16/10" d="1/3/17/14" z={3}>
      <h1>How a Chicago Therapy Practice Cut Ad Spend by 50% While Boosting Search Traffic by 153%</h1>
      <p>Therapists want to spend time helping clients, not worrying about expensive ads. This Chicago practice was spending over $5,000 every month on online ads, but many of the clicks were not turning into actual clients.</p>
      <p>We helped them update their website so people searching for terms like "therapist in Chicago," "trauma therapy," and "eating disorder therapy" could find them naturally on Google.</p>
      <p>In just three months, they cut their monthly ad budget in half (saving $2,500 every month) while getting even more calls from potential clients. Our monthly service paid for itself right away and built a steady stream of new client inquiries.</p>
    </Text>
    <Text m="16/2/22/10" d="18/3/28/14" z={4} align="center" alignM="start" bg="var(--darkAccent)" padding="6% 6% 6% 6%" radius="30px" bulletColor="#fff4ea">
      <h4><span class="c-white">Challenge: </span></h4>
      <ul>
      <li>
      <p><span class="c-white"><strong>Too Much Spent on Ads:</strong> Paying over $5,000 a month with fewer new clients to show for it.</span></p>
      </li>
      <li>
      <p><span class="c-white"><strong>Wrong Leads:</strong> Clicks from people who weren't looking for their specific therapy services.</span></p>
      </li>
      <li>
      <p><span class="c-white"><strong>Hard to Find on Google:</strong> Relying completely on paid ads because their site didn't show up in normal search results.</span></p>
      </li>
      </ul>
    </Text>
    <Text m="22/2/33/10" d="28/3/41/14" z={5} bg="var(--accent)" padding="6% 6% 6% 6%" radius="30px">
      <h4><span class="c-black">Actions:</span></h4>
      <ul>
      <li>
      <p><strong>Fixed Website Mistakes:</strong> Corrected behind-the-scenes errors so Google could easily read and display their website.</p>
      </li>
      <li>
      <p><strong>Focused on Specific Therapies:</strong> Rewrote main pages so people searching for specific care, like trauma or eating disorder support, could easily find them.</p>
      </li>
      <li>
      <p><strong>Set Up for AI Search:</strong> Made sure their practice shows up when people ask tools like ChatGPT or Gemini for local therapist recommendations.</p>
      </li>
      <li>
      <p><strong>Ongoing Support:</strong> Kept their site updated every month so they continue to rank well.</p>
      </li>
      </ul>
    </Text>
    <Img m="33/2/46/10" d="1/16/16/24" z={6} align="center" outline={{ border: '4px solid #fff', radius: '34px' }} src={kaboompicsCloseUpOfWomanTypingOnLaptopOn} alt="Person sitting on a black leather sofa, wearing leopard print pants and a white long-sleeve shirt, using a silver laptop." radius="30px" sizes="(max-width: 767px) 100vw, 33vw" eager />
  </Section>

  <Section theme="dark" grid={{ rows: [17, 9], rowGap: 11, colGap: 28 }}>
    <Text m="2/2/7/10" d="3/2/8/10" z={2} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} bg="hsl(var(--white-hsl) / 0.97)" stroke={{ color: 'var(--accent)', width: '2px' }} padding="6% 6% 6% 6%" radius="20px">
      <h3 class="ta-center"><span class="c-darkAccent">+44% increase</span></h3>
      <p class="ta-center"><span class="c-darkAccent">in clicks for all search terms</span></p>
    </Text>
    <Text m="7/2/12/10" d="3/10/8/18" z={3} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} bg="hsl(var(--white-hsl) / 0.96)" stroke={{ color: 'var(--accent)', width: '2px' }} padding="6% 6% 6% 6%" radius="20px">
      <h3 class="ta-center"><span class="c-darkAccent">+153% increase</span></h3>
      <p class="ta-center"><span class="c-darkAccent">in total impressions</span></p>
    </Text>
    <Text m="12/2/17/10" d="3/18/8/26" z={4} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} bg="hsl(var(--white-hsl) / 0.97)" stroke={{ color: 'var(--accent)', width: '2px' }} padding="6% 6% 6% 6%" radius="20px">
      <h3 class="ta-center"><span class="c-darkAccent">93% increase</span></h3>
      <p class="ta-center"><span class="c-darkAccent">in total clicks for unbranded search</span></p>
    </Text>
  </Section>

  <Section theme="light" height="small" bg={{ src: kaboompicsYoungAsianWomanAtOffice21922, overlay: 0.9, parallax: true }} grid={{ rows: [32, 23], rowGap: 28, colGap: 28 }}>
    <Text m="2/2/4/10" d="2/8/5/20" z={1} align="center" alignM="start">
      <h2 class="ta-center">Results</h2>
    </Text>
    <Shape m="4/2/13/10" d="5/3/11/25" z={2} align="center" fill="hsl(var(--white-hsl) / 0)" stroke={{ color: 'var(--white)', width: '2px' }} radius="30px" />
    <Text m="5/3/12/9" d="6/4/10/11" z={4} zm={3} align="center" radius="20px">
      <h3><span class="c-white">All Search Terms </span></h3>
      <p class="large"><span class="c-white">+44% increase in clicks  </span></p>
      <p class="large"><span class="c-white">+153% increase in impressions</span></p>
      <p class="large"><span class="c-white">Up by 20 positions </span></p>
    </Text>
    <Img m="12/1/15/11" d="6/12/10/24" z={3} zm={8} align="center" src={image2} alt="Analytics dashboard showing total clicks of 6,6300 and total impressions of 603,000 between January 1 and August 21, 2026, with previous period data of 4,610 clicks and 238,000 impressions from May 11 to December 31, 2025. It also displays an average CTR of 1.1% and 1.9%, and average positions of 10.6 and 30.5." fit="contain" sizes="(max-width: 767px) 100vw, 50vw" />
    <Shape m="15/2/23/10" d="11/3/17/25" z={5} zm={4} align="center" fill="hsl(var(--white-hsl) / 0)" stroke={{ color: 'var(--white)', width: '2px' }} radius="30px" />
    <Text m="16/3/21/9" d="11/4/17/12" z={7} zm={5} align="center" radius="20px">
      <h3><span class="c-white">Unbranded Search: </span></h3>
      <p class="large"><span class="c-white">+93% increase in clicks </span></p>
      <p class="large"><span class="c-white">+60% increase in impressions</span></p>
      <p class="large"><span class="c-white">Up by 31 positions </span></p>
    </Text>
    <Img m="21/1/24/11" d="12/12/16/24" z={6} zm={9} align="center" src={image4} alt="A digital statistics report showing total clicks, total impressions, average click-through rate, and average position for two different date ranges." fit="contain" sizes="(max-width: 767px) 100vw, 50vw" />
    <Shape m="24/2/30/10" d="17/3/23/25" z={6} align="center" fill="hsl(var(--white-hsl) / 0)" stroke={{ color: 'var(--white)', width: '2px' }} radius="30px" />
    <Text m="25/3/29/9" d="18/4/22/12" z={8} zm={7} align="center" radius="20px">
      <h3><span class="c-white">AI Visibility</span></h3>
      <p><span class="c-white">Consistent qualified leads coming in from Google, Bing, and Ai Search</span></p>
    </Text>
    <Img m="29/1/32/11" d="18/12/22/24" z={7} zm={10} align="center" src={image6} alt="Line graph showing the popularity of four AI chat platforms from February to June 2026, with ChatGPT.com having the highest usage, followed by Claude.ai, Perplexity.ai, and Gemini.google.com." fit="contain" sizes="(max-width: 767px) 100vw, 50vw" />
  </Section>

  <Section height="small" grid={{ rows: [17, 14], rowGap: 11, colGap: 26 }}>
    <Img m="3/2/16/10" d="3/3/13/25" z={2} align="center" outline={{ border: '4px solid #d34320', radius: '34px' }} src={blueIvoryPurpleCorners} alt="Empty, gradient background with soft pastel colors blending from top left to bottom right." radius="30px" parallax={{ intensity: 20, rotation: 45, zoomStart: 2 }} sizes="(max-width: 767px) 100vw, 92vw" />
    <Img m="2/4/5/8" d="2/12/5/16" z={4} align="center" anim={{ animations: [{ trigger: 'loop', duration: 2, ease: 'ease-in-out', frames: [{ y: '20%', sx: 0.95, sy: 0.95 }], alternate: true, iterations: 1 }] }} src={gradient36abaf04} alt="White stylized cat with a smiling face and closed eyes, outlined in red, on an orange background." fit="contain" sizes="(max-width: 767px) 50vw, 17vw" />
    <Text m="6/3/9/9" d="6/8/8/20" z={4}>
      <h2 class="ta-center">Ready to take the next step?</h2>
    </Text>
    <Button m="10/3/12/9" d="9/9/11/14" z={3} align="center" href="/results">View More Results</Button>
    <Button m="12/3/14/9" d="9/14/11/19" z={4} align="center" href="/contact" variant="secondary" size="large">Get Started</Button>
  </Section>
</Layout>
