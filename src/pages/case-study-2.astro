---
import Button from '../components/blocks/Button.astro';
import Img from '../components/blocks/Img.astro';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Shape from '../components/blocks/Shape.astro';
import Text from '../components/blocks/Text.astro';
import blueIvoryPurpleBlend from '../assets/images/blue-ivory-purple-blend.png';
import blueIvoryPurpleCorners from '../assets/images/blue-ivory-purple-corners.png';
import gradient36abaf04 from '../assets/images/gradient-36abaf04.png';
import image1 from '../assets/images/image1.png';
import image3 from '../assets/images/image3.png';
import image5 from '../assets/images/image5.png';
import kaboompicsYoungAsianWomanAtOffice21922 from '../assets/images/kaboompics-young-asian-woman-at-office-21922.jpg';
import pexelsTimSamuel5838302 from '../assets/images/pexels-tim-samuel-5838302.jpg';
import socialShare6a8726b0 from '../assets/images/social-share-6a8726b0.png';
---

<Layout title="Case Study 2 | Boost Your Practice Today | HelloSEO" description="Discover how HelloSEO increased leads by 72% for a Chicago LGBTQIA+ therapy practice through targeted SEO strategies and technical optimization." ogImage={socialShare6a8726b0}>
  <Section height="medium" bg={{ src: blueIvoryPurpleBlend, overlay: 0.15, eager: true }} grid={{ rows: [63, 35], rowGap: 11, colGap: 34 }}>
    <Text m="1/2/19/10" d="1/3/15/14" z={3}>
      <h1>How We Helped a Niche Therapy Practice Get 72% More Client Inquiries</h1>
      <p>This large, large practice wanted a reliable way to reach people looking for specialized care, specifically sex therapy and LGBTQIA+-affirming support.</p>
      <p>We helped update their website so when individuals search for these specific care types, the practice naturally shows up at the top of their search results.</p>
      <p>In six months, they saw a 72% boost in new client inquiries from Google and AI search tools. By improving their organic search results, they were also able to adjust their ad spend so paid ads didn't get in the way of their free website traffic.</p>
    </Text>
    <Text m="20/2/31/10" d="15/3/23/14" z={4} bg="var(--darkAccent)" padding="6% 6% 6% 6%" radius="30px" bulletColor="#fff4ea">
      <h4><span class="c-white">The Problem:&nbsp;</span></h4>
      <ul>
      <li>
      <p><span class="c-white"><strong>Inconsistent Client Inquiries:</strong> Looking for a steady, reliable stream of new client leads for a large practice.</span></p>
      </li>
      <li>
      <p><span class="c-white"><strong>Reaching the Right Audience:</strong> Struggling to show up in front of individuals specifically searching for sex therapy and LGBTQIA+-affirming care.</span></p>
      </li>
      </ul>
    </Text>
    <Text m="31/2/50/10" d="23/3/36/14" z={5} align="center" alignM="start" bg="var(--accent)" padding="6% 6% 6% 6%" radius="30px">
      <h4><span class="c-black">What We Did: </span></h4>
      <ul>
      <li>
      <p><strong>Highlighted Core Specialties:</strong> Updated their main website pages so people searching for sex therapy and LGBTQIA+ care could easily find them.</p>
      </li>
      <li>
      <p><strong>Fixed Behind-the-Scenes Errors:</strong> Corrected website issues so search engines could index and display their pages properly.</p>
      </li>
      <li>
      <p><strong>Balanced Ads and Organic Traffic:</strong> Advised on ad strategy so paid ads wouldn't compete with their improving organic search positions.</p>
      </li>
      <li>
      <p><strong>Set Up for AI Search:</strong> Made sure their practice shows up when people ask AI tools (like ChatGPT) for inclusive therapist recommendations.</p>
      </li>
      </ul>
    </Text>
    <Img m="50/2/64/10" d="1/16/16/24" z={6} align="center" outline={{ border: '4px solid #fff', radius: '34px' }} src={pexelsTimSamuel5838302} alt="Two women sitting at a wooden table together, engaging in a conversation. One is working on a laptop with her hand on the keyboard, and the other is leaning forward with her hand on her arm, smiling and making eye contact." radius="30px" sizes="(max-width: 767px) 100vw, 33vw" eager />
  </Section>

  <Section theme="dark" grid={{ rows: [16, 9], rowGap: 11, colGap: 28 }}>
    <Text m="2/2/7/10" d="3/2/8/10" z={2} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} bg="hsl(var(--white-hsl) / 0.97)" stroke={{ color: 'var(--accent)', width: '2px' }} padding="6% 6% 6% 6%" radius="20px">
      <h3 class="ta-center"><span class="c-darkAccent">72% increase</span></h3>
      <p class="ta-center"><span class="c-darkAccent">in leads (from Google and AI) after six months</span></p>
    </Text>
    <Text m="7/2/12/10" d="3/10/8/18" z={3} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} bg="hsl(var(--white-hsl) / 0.96)" stroke={{ color: 'var(--accent)', width: '2px' }} padding="6% 6% 6% 6%" radius="20px">
      <h3 class="ta-center"><span class="c-darkAccent">43% increase</span></h3>
      <p class="ta-center"><span class="c-darkAccent">on total impressions</span></p>
    </Text>
    <Text m="12/2/17/10" d="3/18/8/26" z={4} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} bg="hsl(var(--white-hsl) / 0.97)" stroke={{ color: 'var(--accent)', width: '2px' }} padding="6% 6% 6% 6%" radius="20px">
      <h3 class="ta-center"><span class="c-darkAccent">19% increase</span></h3>
      <p class="ta-center"><span class="c-darkAccent">on total clicks</span></p>
    </Text>
  </Section>

  <Section theme="light" height="small" bg={{ src: kaboompicsYoungAsianWomanAtOffice21922, overlay: 0.9, parallax: true }} grid={{ rows: [28, 22], rowGap: 28, colGap: 28 }}>
    <Text m="2/2/4/10" d="1/8/4/20" z={1} align="center" alignM="start">
      <h2 class="ta-center">Results</h2>
    </Text>
    <Shape m="4/2/13/10" d="4/3/10/25" z={2} align="center" fill="hsl(var(--white-hsl) / 0)" stroke={{ color: 'var(--white)', width: '2px' }} radius="30px" />
    <Text m="5/3/8/9" d="4/4/10/11" z={4} zm={3} align="center" radius="20px">
      <h3><span class="c-white">All Search Terms (Branded and Unbranded) </span></h3>
      <p class="large"><span class="c-white">Total clicks: 19% increase</span></p>
      <p><span class="c-white">Total impressions: 43% increase</span></p>
      <p><span class="c-white">Total position increase: 14</span></p>
    </Text>
    <Img m="10/1/13/11" d="4/12/10/24" z={3} zm={8} align="center" src={image1} alt="An analytics dashboard showing data for total clicks, total impressions, average CTR, and average position across two date ranges, with different colors for each metric." fit="contain" sizes="(max-width: 767px) 100vw, 50vw" />
    <Shape m="13/2/21/10" d="10/3/16/25" z={5} zm={4} align="center" fill="hsl(var(--white-hsl) / 0)" stroke={{ color: 'var(--white)', width: '2px' }} radius="30px" />
    <Text m="14/3/19/9" d="10/4/16/12" z={7} zm={5} align="center" radius="20px">
      <h3><span class="c-white">Unbranded Search: </span></h3>
      <p class="large"><span class="c-white">72% increase in leads (from Google and AI) after six months.</span></p>
      <p><span class="c-white">Unbranded clicks: 33% increase</span></p>
      <p><span class="c-white">Unbranded impressions: 26%</span></p>
      <p><span class="c-white">Unbranded position increase: 23</span></p>
    </Text>
    <Img m="19/1/22/11" d="10/12/16/24" z={6} zm={9} align="center" src={image3} alt="Digital marketing analytics dashboard showing total clicks, impressions, average click-through rate (CTR), and average position for two periods, from January to August 2026 and May to December 2025." fit="contain" sizes="(max-width: 767px) 100vw, 50vw" />
    <Shape m="22/2/28/10" d="16/3/22/25" z={6} align="center" fill="hsl(var(--white-hsl) / 0)" stroke={{ color: 'var(--white)', width: '2px' }} radius="30px" />
    <Text m="23/3/25/9" d="17/4/20/12" z={8} zm={7} align="center" radius="20px">
      <h3><span class="c-white">AI Visibility</span></h3>
      <p><span class="c-white">Consistent AI growth and visibility </span></p>
    </Text>
    <Img m="25/1/28/11" d="17/12/21/24" z={7} zm={10} align="center" src={image5} alt="A line graph comparing search trends from October 2025 to May 2026 for chatgpt.com, claude.ai, and gemini.google.com, showing a significant increase in interest for chatgpt.com." fit="contain" sizes="(max-width: 767px) 100vw, 50vw" />
  </Section>

  <Section height="small" grid={{ rows: [17, 14], rowGap: 11, colGap: 26 }}>
    <Img m="3/2/16/10" d="3/3/13/25" z={2} align="center" outline={{ border: '4px solid #d34320', radius: '34px' }} src={blueIvoryPurpleCorners} alt="A blurred gradient background with soft pastel colors transitioning from light blue to pink and purple." radius="30px" parallax={{ intensity: 20, rotation: 45, zoomStart: 2 }} sizes="(max-width: 767px) 100vw, 92vw" />
    <Img m="2/4/5/8" d="2/12/5/16" z={4} align="center" anim={{ animations: [{ trigger: 'loop', duration: 2, ease: 'ease-in-out', frames: [{ y: '20%', sx: 0.95, sy: 0.95 }] }] }} src={gradient36abaf04} alt="A minimalist illustration of a smiling cat face with a curled tail, set against a red background." fit="contain" sizes="(max-width: 767px) 50vw, 17vw" />
    <Text m="6/3/9/9" d="6/8/8/20" z={4}>
      <h2 class="ta-center">Ready to take the next step?</h2>
    </Text>
    <Button m="10/3/12/9" d="9/9/11/14" z={3} align="center" href="/results">View More Results</Button>
    <Button m="12/3/14/9" d="9/14/11/19" z={4} align="center" href="/contact" variant="secondary" size="large">Get Started</Button>
  </Section>
</Layout>
