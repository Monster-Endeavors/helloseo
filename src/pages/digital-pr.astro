---
import Button from '../components/blocks/Button.astro';
import Img from '../components/blocks/Img.astro';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Shape from '../components/blocks/Shape.astro';
import Text from '../components/blocks/Text.astro';
import img16a848e64 from '../assets/images/1-6a848e64.png';
import img38 from '../assets/images/38.png';
import img56 from '../assets/images/56.png';
import gradient2 from '../assets/images/gradient-2.png';
import gradient3 from '../assets/images/gradient-3.png';
import pexelsBlueBird7218676 from '../assets/images/pexels-blue-bird-7218676.jpg';
import pexelsPolinaZimmerman3958380 from '../assets/images/pexels-polina-zimmerman-3958380.jpg';
import socialShare6a8726b0 from '../assets/images/social-share-6a8726b0.png';
---

<Layout title="Digital PR and Backlinks for Therapists | HelloSEO" description="Enhance your practice's visibility with targeted digital PR strategies, media placements, and backlinks. Build credibility and attract ideal clients today." ogImage={socialShare6a8726b0} footerOffset="2vw" headerTheme="white">
  <Section theme="white" bg={{ src: pexelsBlueBird7218676, overlay: 0.86, focal: '59.6% 65.6%', parallax: true, eager: true }} grid={{ rows: [18, 18], rowGap: 11, colGap: 11 }}>
    <Text m="3/2/13/10" d="5/8/13/20" z={2} align="center">
      <p class="large ta-center"><strong>DIGITAL PR</strong></p>
      <h2 class="ta-center">A strong <span class="c-lightAccent">online reputation</span> builds digital credibility &amp; leads to a caseload of ideal clients.  </h2>
      <p class="ta-center">Ethically acquire meaningful press features that boost SEO and AEO through credible media outlets your future clients already trust.</p>
    </Text>
    <Button m="14/2/16/10" d="14/11/16/17" z={5} align="center" href="/contact">GET STARTED</Button>
  </Section>

  <Section height="small" grid={{ rows: [34, 18], rowGap: 11, colGap: 11 }}>
    <Img m="1/2/17/10" d="2/3/19/11" z={1} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.4, ease: 'ease-out', frames: [{ r: -4 }, {  }] }] }} outline={{ border: '4px solid #fff', radius: '34px' }} src={img56} alt="Person holding a closed beige laptop in front of their face, wearing a white jacket and beige pants." radius="30px" sizes="(max-width: 767px) 100vw, 33vw" />
    <Text m="17/2/33/10" d="4/13/16/24" z={2} alignM="center">
      <h2>therapy is personal. people want to feel a sense of connection well before their first consultation.</h2>
      <p>We help you land intentional press coverage that centers your credibility and showcases your personality so people know what you do but more importantly, <em>the distinct way you do it,</em> leading to a stronger client connection. </p>
      <p><strong>Bonus: </strong>Since Google and AI models mine the internet for mentions to measure how qualified you are, every digital press piece makes you more credible. You’re more likely to be included in search results on traditional sites like Google or Safari and AI sites like ChatPT, Claude, Gemini, etc.</p>
    </Text>
    <Button m="33/2/35/10" d="16/13/18/18" z={3} align="center" href="/contact">Get Started</Button>
  </Section>

  <Section height="medium" grid={{ rows: [56, 23], rowGap: 11, colGap: 35 }}>
    <Text m="1/2/8/10" d="1/6/6/22" z={1}>
      <h2 class="ta-center">for practice owners and solo therapists who want to <span class="c-lightAccent">increase online authority</span> through authentic PR features. </h2>
    </Text>
    <Text m="8/2/15/10" d="6/6/9/22" z={2} alignM="center">
      <p class="large ta-center">Every media feature builds your practice's authority in two key ways: search engines take it as a credibility signal that lifts your overall visibility, and potential clients see press as proof of your expertise. We build a tailored PR plan around your specialties. Expect the following every month:</p>
    </Text>
    <Shape m="16/2/24/10" d="10/2/20/8" z={3} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} fill="var(--lightAccent)" stroke={{ color: '#fff', width: '6px' }} radius="10px" />
    <Text m="17/3/22/9" d="11/3/19/7" z={4} alignM="center">
      <h3><span class="c-white">Backlink Acquisition</span></h3>
      <p><span class="c-white">2–5 backlinks per month from relevant, authoritative outlets that are prioritized to align with your brand and SEO strategy.</span></p>
    </Text>
    <Shape m="24/2/32/10" d="10/8/20/14" z={4} zm={5} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} fill="var(--accent)" stroke={{ color: '#fff', width: '6px' }} radius="10px" />
    <Text m="25/3/30/9" d="11/9/18/13" z={5} zm={6} alignM="center">
      <h3><span class="c-black">Backlink Reporting</span></h3>
      <p><span class="c-black">A monthly summary of secured placements, including domain authority and outlet reach.</span></p>
    </Text>
    <Shape m="32/2/41/10" d="10/14/20/20" z={5} zm={7} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} fill="var(--mauve)" stroke={{ color: '#fff', width: '6px' }} radius="10px" />
    <Text m="33/3/39/9" d="11/15/19/19" z={7} zm={8} alignM="center">
      <h3><span class="c-white">Competitor Benchmarking</span></h3>
      <p><span class="c-white">A quarterly snapshot comparing your backlink profile to competitors, with opportunities flagged for growth.</span></p>
    </Text>
    <Shape m="41/2/49/10" d="10/20/20/26" z={8} zm={9} align="center" anim={{ animations: [{ trigger: 'hover', duration: 0.5, ease: 'spring', bounce: 0.3, frames: [{ sx: 1.05, sy: 1.05 }] }] }} fill="var(--darkAccent)" stroke={{ color: '#fff', width: '6px' }} radius="10px" />
    <Text m="42/3/47/9" d="11/21/18/25" z={9} zm={10} alignM="center">
      <h3><span class="c-white">Amplification Support</span></h3>
      <p><span class="c-white">Quarterly guidance on turning media wins into website badges, social proof, and repurposed content.</span></p>
    </Text>
    <Text m="50/2/57/10" d="21/7/24/21" z={3} alignM="center">
      <p class="ta-center"><span class="c-black"><strong>P.S. What’s a backlink? </strong></span>An SEO backlink is a clickable hyperlink on someone else’s website that points back to yours. Think of it as a digital “vote of confidence" that boosts your reputation for search engines looking for qualified sites to share. The more reputable the site that links to yours (IE the New York Times) the better your results. </p>
    </Text>
  </Section>

  <Section theme="white" grid={{ rows: [16, 11], rowGap: 11, colGap: 11 }}>
    <Shape m="3/2/15/10" d="2/3/9/25" z={1} align="center" fill="var(--mauve)" stroke={{ color: 'var(--black)', width: '15px' }} radius="30px" />
    <Img m="1/2/4/10" d="4/2/8/5" z={3} align="center" anim={{ animations: [{ trigger: 'loop', duration: 4, ease: 'ease-in-out', frames: [{ y: '20%', sx: 0.95, sy: 0.95 }], alternate: true, iterations: 1 }] }} src={gradient3} alt="A smiling cartoon cat with closed eyes and a curved tail." fit="contain" sizes="(max-width: 767px) 100vw, 13vw" />
    <Text m="4/3/14/9" d="3/7/8/23" z={2} align="center">
      <h3><span class="c-white">“The team at HelloSEO is made of SEO wizards.</span></h3>
      <p><span class="c-white">“The team at HelloSEO is made of SEO wizards. Jade is the GOAT and she has transformed and grown the authority of every client she has touched. At least, I speak for all of the clients I referred to her.”</span></p>
      <p class="large"><span class="c-white"><strong>- AGGIE C.</strong></span></p>
    </Text>
  </Section>

  <Section theme="dark" grid={{ rows: [35, 18], rowGap: 11, colGap: 11 }}>
    <Img m="1/1/14/11" d="1/16/19/27" z={2} align="center" src={img38} alt="Two women having a conversation in a waiting room; one is taking notes, the other listens attentively." sizes="(max-width: 767px) 100vw, 46vw" />
    <Text m="15/2/17/10" d="3/3/5/14" z={2} align="center" alignM="start">
      <h2>Ideal If You Are:</h2>
    </Text>
    <Text m="17/2/29/10" d="5/3/13/14" z={4} align="center" alignM="start" bulletIcon={img16a848e64}>
      <ul>
      <li>
      <p class="large">Ready to build online credibility beyond your own website</p>
      </li>
      <li>
      <p class="large">Interested in being featured in publications, podcasts, or media your ideal clients already trust</p>
      </li>
      <li>
      <p class="large">Looking to strengthen your SEO with high-quality backlinks, not just on-site optimization</p>
      </li>
      <li>
      <p class="large">Wanting "as seen in" social proof to build trust with new visitors</p>
      </li>
      <li>
      <p class="large">Comfortable having some placements be pitched on your behalf (with full approval before anything goes live)</p>
      </li>
      </ul>
    </Text>
    <Text m="29/2/31/10" d="13/3/14/11" z={5} align="center" radius="100px">
      <p class="large"><span class="c-accent"><strong>Monthly Investment: Starting at $850</strong></span></p>
    </Text>
    <Button m="32/2/34/10" d="15/3/17/9" z={6} align="center" href="/contact">get started</Button>
  </Section>

  <Section theme="white" height="small" grid={{ rows: [19, 11], rowGap: 11, colGap: 11 }}>
    <Shape m="2/2/19/10" d="3/3/11/25" z={1} align="center" fill="var(--accent)" stroke={{ color: 'var(--darkAccent)', width: '15px' }} radius="30px" />
    <Img m="1/2/4/10" d="5/23/9/26" z={3} align="center" anim={{ animations: [{ trigger: 'loop', duration: 4, ease: 'ease-in-out', frames: [{ y: '20%', sx: 0.95, sy: 0.95 }], alternate: true, iterations: 1 }] }} src={gradient2} alt="Smiling cat icon with closed eyes and curled tail on a dark background." fit="contain" sizes="(max-width: 767px) 100vw, 13vw" />
    <Text m="4/3/18/9" d="4/5/10/21" z={2} align="center">
      <h3>“Jade and her team at Hello SEO are amazing. </h3>
      <p>“Jade and her team at Hello SEO are amazing. I have worked with quite a few companies in the past as an agency leader who claim to be SEO Experts. Jade is the real deal. She does not send over a spreadsheet of numbers a client does not understand and say it’s all great. Instead she shares ideas, meaningful data and truly invests herself into the client and their goals. Highly recommend Hello SEO!”</p>
      <p class="large"><strong>- CHRISTINE M.</strong></p>
    </Text>
  </Section>

  <Section theme="white" inset divider={{ height: '2vw', concave: true }} grid={{ rows: [15, 18], rowGap: 11, colGap: 11 }}>
    <Img m="2/2/14/10" d="2/2/17/26" z={1} align="center" outline={{ border: '4px solid #d34320', radius: '34px' }} src={pexelsPolinaZimmerman3958380} alt="Two people sitting on a bed, smiling and talking with a third person whose back is to the camera, in a bright room with large windows." focal="59.1% 60%" radius="30px" overlay={{ opacity: 1, color: 'hsl(var(--black-hsl) / 0.65)' }} parallax={{ intensity: 20, rotation: 45, zoomStart: 2 }} sizes="(max-width: 767px) 100vw, 100vw" />
    <Text m="3/3/10/9" d="6/7/11/21" z={2} align="center" alignM="start">
      <h2 class="ta-center"><span class="c-white">You’re already an </span><span class="c-accent">expert in your field</span><span class="c-white">. It’s time you have the online presence to match.</span></h2>
    </Text>
    <Button m="10/3/12/9" d="12/11/14/17" z={3} align="center" href="/contact">Get Started</Button>
  </Section>
</Layout>
