---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import defaultOg from '../assets/images/social-share-6a8726b0.png';
import '../styles/fonts.css';
import '../styles/themes.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/blocks.css';
import '../styles/header.css';
import '../styles/lists.css';
import '../styles/forms.css';
import '../styles/blog.css';
import '../styles/cookies.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: ImageMetadata;
  noindex?: boolean;
  /** height of the divider on the page's last section, so the footer tucks under it */
  footerOffset?: string;
  /** colour theme of the first section (the header follows it) */
  headerTheme?: string;
}

const { title, description, ogImage = defaultOg, noindex, footerOffset, headerTheme } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const og = await getImage({ src: ogImage, format: 'png' });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: light)" href="/favicon-light.png" />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href="/favicon-dark.png" />
    <link rel="preload" href="/fonts/arimo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="HelloSEO" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogUrl} />

    <!-- Google Analytics (consent mode: analytics stays denied until the visitor accepts) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BBCS9KY8F3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', wait_for_update: 500 });
      try {
        var prefs = JSON.parse(localStorage.getItem('cookie-consent') || 'null');
        if (prefs) gtag('consent', 'update', { analytics_storage: prefs.performance ? 'granted' : 'denied', ad_storage: prefs.marketing ? 'granted' : 'denied' });
      } catch (e) {}
      gtag('config', 'G-BBCS9KY8F3');
    </script>

    <script is:inline>
      // Enable reveal animations only when JS runs (and motion is welcome).
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-anim');
    </script>
  </head>
  <body>
    <div class="site-wrapper">
      <Header theme={headerTheme || undefined} />
      <main id="page">
        <slot />
      </main>
      <Footer offset={footerOffset} />
    </div>
    <CookieBanner />
    <script>
      import { initAnimations } from '../scripts/animations';
      import { initDividers } from '../scripts/divider';
      import { initParallax } from '../scripts/parallax';
      initDividers();
      initParallax();
      initAnimations();
    </script>
    <!-- accessiBe accessibility widget (as on the original site) -->
    <script is:inline>
      (function () {
        var s = document.createElement('script');
        s.src = 'https://acsbapp.com/apps/app/dist/js/app.js';
        s.async = true;
        s.onload = function () { window.acsbJS && acsbJS.init(); };
        (document.head || document.body).appendChild(s);
      })();
    </script>
  </body>
</html>
